# Runtime mode
TELEGRAM_MODE=tdlib_discovery_only

# Bot API (required only for bot_api_only and bot_api_plus_tdlib_stub)
TELEGRAM_BOT_TOKEN=replace_me

# TDLib / MTProto (required for bot_api_plus_tdlib_stub and tdlib_discovery_only)
TELEGRAM_API_ID=replace_me
TELEGRAM_API_HASH=replace_me
TELEGRAM_PHONE_NUMBER=replace_me
TELEGRAM_2FA_PASSWORD=
TELEGRAM_READ_ONLY_MODE=true
TELEGRAM_SESSION_DIR=.runtime/telegram_session
DISCOVERY_DB_PATH=data/derived/discovery.db
DISCOVERY_SEARCH_LIMIT=50
DISCOVERY_SIMILAR_DEPTH=2
DISCOVERY_SIMILAR_PER_NODE=20
DISCOVERY_SIMILAR_MAX_NODES=120
DISCOVERY_MESSAGE_PREVIEW_LIMIT=30

# Optional defaults
TELEGRAM_REQUEST_TIMEOUT_SECONDS=20
