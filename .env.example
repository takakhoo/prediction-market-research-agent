# -----------------------------
# Supabase
# -----------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_DB_URL=replace_me
SUPABASE_DIRECT_DB_URL=replace_me
DATABASE_URL=replace_me
DIRECT_URL=replace_me
MARKET_PROB_LIKELY_THRESHOLD=0.75
MARKET_PROB_UNLIKELY_THRESHOLD=0.25
MARKET_HIGH_COMPETITION_VOLUME_USD=5000000
MARKET_INGEST_PAGE_LIMIT=200
MARKET_INGEST_MAX_PAGES=10
MARKET_STORE_OUTCOMES=true
MARKET_STORE_SNAPSHOTS=false
MARKET_ANALYSIS_KEEP_HISTORY=false

# -----------------------------
# Telegram Discovery
# -----------------------------
TELEGRAM_MODE=tdlib_discovery_only
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_API_ID=replace_me
TELEGRAM_API_HASH=replace_me
TELEGRAM_PHONE_NUMBER=replace_me
TELEGRAM_2FA_PASSWORD=
TELEGRAM_READ_ONLY_MODE=true
TELEGRAM_SESSION_DIR=.runtime/telegram_session
# Dashboard uses isolated TDLib session by default to avoid AUTH_KEY_DUPLICATED with live agent.
WORKSPACE_TDLIB_SESSION_MODE=isolated
WORKSPACE_TDLIB_SESSION_DIR=.runtime/telegram_session_workspace
DISCOVERY_DB_PATH=data/derived/discovery.db
DISCOVERY_SEARCH_LIMIT=50
DISCOVERY_SIMILAR_DEPTH=2
DISCOVERY_SIMILAR_PER_NODE=20
DISCOVERY_SIMILAR_MAX_NODES=120
DISCOVERY_MESSAGE_PREVIEW_LIMIT=30
TELEGRAM_REQUEST_TIMEOUT_SECONDS=20

# -----------------------------
# Polymarket
# -----------------------------
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_DATA_BASE_URL=https://data-api.polymarket.com
POLYMARKET_TIMEOUT_SECONDS=20
POLYMARKET_CHAIN_ID=137
POLYMARKET_SIGNATURE_TYPE=0
AI_RUNTIME_MODE=prefer_ai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_HTTP_REFERER=
OPENAI_APP_NAME=polymarket-news-agent
OPENAI_TIMEOUT_SECONDS=30
AI_MARKET_CLASSIFIER_MODEL=gpt-4o-mini
AI_TELEGRAM_QUERY_PLANNER_MODEL=gpt-4o-mini
AI_TELEGRAM_CHANNEL_RELEVANCE_MODEL=gpt-4o-mini
AI_TELEGRAM_MESSAGE_MATCHER_MODEL=gpt-4o-mini
AI_ENABLE_MESSAGE_MATCHER=false
AI_MESSAGE_MATCHER_API_KEY=
AI_MESSAGE_MATCHER_BASE_URL=
AI_MESSAGE_MATCHER_HTTP_REFERER=
AI_MESSAGE_MATCHER_APP_NAME=polymarket-news-agent
# OpenRouter example:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# AI_TELEGRAM_MESSAGE_MATCHER_MODEL=openrouter/your-free-fast-model
# Optional Google SERP provider keys for official t.me channel harvesting
SERPER_API_KEY=
SERPAPI_API_KEY=
SERP_TIMEOUT_SECONDS=15
SERP_RESULTS_PER_QUERY=8
PROMPTS_DIR=configs/prompts
POLYMARKET_PRIVATE_KEY=replace_me
POLYMARKET_FUNDER_ADDRESS=replace_me
POLYMARKET_CLOB_API_KEY=replace_me
POLYMARKET_CLOB_SECRET=replace_me
POLYMARKET_CLOB_PASSPHRASE=replace_me
